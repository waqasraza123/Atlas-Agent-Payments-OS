APP_ENV=staging
LOG_LEVEL=info
RELEASE_STAGE=private-beta
HEALTHCHECK_TIMEOUT_MS=2500
AUTH_SESSION_SIGNING_SECRET=replace-in-secret-manager
AUTH_PROVIDER_MODE=external-oidc
AUTH_IDENTITY_BRIDGE_SECRET=replace-in-secret-manager
AUTH_IDENTITY_BRIDGE_PROVIDER=generic-sso
AUTH_EXTERNAL_OIDC_ISSUER=https://id.staging.atlas.example
AUTH_EXTERNAL_OIDC_AUDIENCE=atlas-agent-payments-os
AUTH_EXTERNAL_OIDC_PROVIDER=okta-staging
AUTH_EXTERNAL_OIDC_JWKS_JSON={"keys":[]}
AUTH_IDENTITY_SESSION_TTL_MINUTES=480
AUTH_LOCAL_SESSION_TTL_MINUTES=480
AUTH_SUPPORT_ACCESS_TTL_MINUTES=60
AUTH_SUPPORT_ACCESS_REVIEW_TTL_HOURS=24
AUTH_SUPPORT_ACCESS_REVIEW_LOOKAHEAD_HOURS=24
AUTH_SUPPORT_ACCESS_ALLOWED_EMAILS=operator@atlas.local,operator-admin@atlas.local
APP_REVISION=staging-build
DEPLOYMENT_SLOT=green
DATABASE_BACKUP_DIR=backups/staging
RESTORE_DRILL_MAX_AGE_HOURS=168
SECRET_ROTATION_MAX_AGE_HOURS=720
SECRET_ROTATION_REQUIRED_KEYS=AUTH_SESSION_SIGNING_SECRET,AUTH_IDENTITY_BRIDGE_SECRET,DATABASE_URL,STRIPE_SECRET_KEY,STRIPE_WEBHOOK_SECRET,MINIO_SECRET_KEY
RELEASE_ARTIFACT_ID=atlas-staging-build
RELEASE_ARTIFACT_SHA256=2222222222222222222222222222222222222222222222222222222222222222
NEXT_PUBLIC_APP_URL=https://staging.atlas.example
API_BASE_URL=https://api.staging.atlas.example
API_PORT=4000
DATABASE_URL=postgresql://atlas:replace-in-secret-manager@postgres.staging.internal:5432/atlas
REDIS_URL=redis://redis.staging.internal:6379
STRIPE_SECRET_KEY=replace-in-secret-manager
STRIPE_WEBHOOK_SECRET=replace-in-secret-manager
PROGRAMMABLE_SETTLEMENT_ENABLED=true
PROGRAMMABLE_SETTLEMENT_CHAIN_KEY=BASE_SEPOLIA
PROGRAMMABLE_SETTLEMENT_CHAIN_ID=84532
PROGRAMMABLE_SETTLEMENT_NETWORK_NAME=Base Sepolia
PROGRAMMABLE_SETTLEMENT_ASSET_SYMBOL=USDC
PROGRAMMABLE_SETTLEMENT_EXPLORER_BASE_URL=https://sepolia.basescan.org/tx/
PROGRAMMABLE_SETTLEMENT_REQUIRED_CONFIRMATIONS=2
MINIO_ENDPOINT=minio.staging.internal
MINIO_PORT=9000
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=replace-in-secret-manager
MINIO_SECRET_KEY=replace-in-secret-manager
MINIO_BUCKET_RECEIPTS=atlas-receipts-staging
MAILHOG_SMTP_URL=smtp://mailhog.staging.internal:1025
