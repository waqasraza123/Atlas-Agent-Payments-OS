APP_ENV=production
LOG_LEVEL=info
RELEASE_STAGE=ga
HEALTHCHECK_TIMEOUT_MS=2500
AUTH_SESSION_SIGNING_SECRET=replace-in-secret-manager
AUTH_PROVIDER_MODE=identity-bridge
AUTH_IDENTITY_BRIDGE_SECRET=replace-in-secret-manager
AUTH_IDENTITY_BRIDGE_PROVIDER=generic-sso
AUTH_LOCAL_SESSION_TTL_MINUTES=480
AUTH_SUPPORT_ACCESS_TTL_MINUTES=60
AUTH_SUPPORT_ACCESS_ALLOWED_EMAILS=replace-in-secret-manager
APP_REVISION=production-build
DEPLOYMENT_SLOT=blue
DATABASE_BACKUP_DIR=backups/production
NEXT_PUBLIC_APP_URL=https://atlas.example
API_BASE_URL=https://api.atlas.example
API_PORT=4000
DATABASE_URL=postgresql://atlas:replace-in-secret-manager@postgres.production.internal:5432/atlas
REDIS_URL=redis://redis.production.internal:6379
STRIPE_SECRET_KEY=replace-in-secret-manager
STRIPE_WEBHOOK_SECRET=replace-in-secret-manager
PROGRAMMABLE_SETTLEMENT_ENABLED=true
PROGRAMMABLE_SETTLEMENT_CHAIN_KEY=BASE_MAINNET
PROGRAMMABLE_SETTLEMENT_CHAIN_ID=8453
PROGRAMMABLE_SETTLEMENT_NETWORK_NAME=Base
PROGRAMMABLE_SETTLEMENT_ASSET_SYMBOL=USDC
PROGRAMMABLE_SETTLEMENT_EXPLORER_BASE_URL=https://basescan.org/tx/
PROGRAMMABLE_SETTLEMENT_REQUIRED_CONFIRMATIONS=6
MINIO_ENDPOINT=minio.production.internal
MINIO_PORT=9000
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=replace-in-secret-manager
MINIO_SECRET_KEY=replace-in-secret-manager
MINIO_BUCKET_RECEIPTS=atlas-receipts-production
MAILHOG_SMTP_URL=smtp://mailhog.production.internal:1025
