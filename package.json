{
  "name": "atlas-agent-payments-os",
  "private": true,
  "version": "0.1.0",
  "description": "Atlas Agent Payments OS is a premium B2B control plane for AI agent spending on paid APIs and digital services.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.11.1",
  "homepage": "https://github.com/waqasraza123/Atlas-Agent-Payments-OS#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waqasraza123/Atlas-Agent-Payments-OS.git"
  },
  "bugs": {
    "url": "https://github.com/waqasraza123/Atlas-Agent-Payments-OS/issues"
  },
  "keywords": [
    "agent-payments",
    "ai-agents",
    "approvals",
    "audit-trail",
    "bullmq",
    "digital-services",
    "nest",
    "nextjs",
    "payments-control-plane",
    "policy-engine",
    "prisma",
    "typescript"
  ],
  "engines": {
    "node": "24.x",
    "pnpm": ">=10.11.1"
  },
  "scripts": {
    "install": "node ./scripts/install.mjs",
    "build": "pnpm typecheck",
    "dev": "turbo run dev --parallel --filter=@atlas/web --filter=@atlas/api --filter=@atlas/worker",
    "dev:web": "pnpm --filter @atlas/web dev",
    "dev:api": "pnpm --filter @atlas/api dev",
    "dev:worker": "pnpm --filter @atlas/worker dev",
    "infra:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker/docker-compose.yml down",
    "db:generate": "pnpm --filter @atlas/database db:generate",
    "db:migrate": "pnpm --filter @atlas/database db:migrate",
    "db:seed": "pnpm --filter @atlas/database db:seed",
    "db:backup": "sh ./scripts/backup-database.sh",
    "db:restore": "sh ./scripts/restore-database.sh",
    "hooks:install": "git config core.hooksPath .githooks",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @atlas/api test:e2e && pnpm --filter @atlas/web test:e2e",
    "verify:phase0": "pnpm typecheck && pnpm test && pnpm test:e2e && pnpm build",
    "verify:env": "pnpm exec tsx ./scripts/validate-env.ts --file .env.example --service api --service web --service worker && pnpm exec tsx ./scripts/validate-env.ts --file .env.development.example --service api --service web --service worker && pnpm exec tsx ./scripts/validate-env.ts --file .env.staging.example --service api --service web --service worker && pnpm exec tsx ./scripts/validate-env.ts --file .env.production.example --service api --service web --service worker",
    "verify:tenant-boundaries": "node ./scripts/verify-tenant-boundaries.mjs",
    "verify:rollback": "sh ./scripts/verify-rollback-readiness.sh",
    "verify:restore-drill": "sh ./scripts/verify-restore-drill.sh",
    "verify:release": "sh ./scripts/verify-release.sh",
    "verify:ops": "sh ./scripts/verify-ops.sh",
    "observability:automation": "pnpm exec tsx ./scripts/run-observability-automation.ts",
    "secrets:rotation:manifest": "pnpm exec tsx ./scripts/create-secret-rotation-manifest.ts",
    "secrets:rotation:execute": "pnpm exec tsx ./scripts/execute-secret-rotation.ts",
    "release:manifest": "pnpm exec tsx ./scripts/create-release-manifest.ts --service api",
    "release:manifest:all": "pnpm exec tsx ./scripts/create-release-manifest.ts --service api && pnpm exec tsx ./scripts/create-release-manifest.ts --service web && pnpm exec tsx ./scripts/create-release-manifest.ts --service worker",
    "promote:staging": "pnpm exec tsx ./scripts/promote-release.ts --from development --to staging --services all",
    "promote:production": "pnpm exec tsx ./scripts/promote-release.ts --from staging --to production --services all",
    "verify:push": "sh ./scripts/verify-push.sh",
    "safe-push": "sh ./scripts/safe-push.sh"
  },
  "devDependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1029.0",
    "@eslint/js": "^9.36.0",
    "@nestjs/testing": "^11.1.18",
    "@next/eslint-plugin-next": "^16.2.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.6.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "jsdom": "^29.0.2",
    "supertest": "^7.2.2",
    "tsx": "^4.20.5",
    "turbo": "^2.5.8",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.44.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.4"
  }
}
