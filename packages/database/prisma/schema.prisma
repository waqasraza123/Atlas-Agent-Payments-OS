generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationKind {
  BUYER
  SELLER
  OPERATOR
}

enum MembershipRole {
  OWNER
  ADMIN
  OPERATOR
  REVIEWER
  FINANCE
}

enum AgentStatus {
  DRAFT
  ACTIVE
  PAUSED
  DISABLED
}

enum PolicyStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ServiceStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ServiceVisibilityMode {
  PRIVATE
  TRUSTED_BUYERS
  PUBLIC
}

enum ServicePricingModel {
  FIXED
}

enum SpendRequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  EXECUTING
  COMPLETED
  FAILED
  CANCELED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  VOIDED
}

enum PaymentRail {
  INTERNAL_SIMULATED
  STRIPE
  PROGRAMMABLE_USDC
}

enum ReceiptStatus {
  PENDING
  AVAILABLE
  FAILED
}

enum ProgrammableSettlementChain {
  BASE_SEPOLIA
  BASE_MAINNET
}

enum WalletVerificationStatus {
  PENDING
  VERIFIED
  REVOKED
}

enum OperatorCaseCategory {
  PAYMENT_FAILURE
  PAYMENT_RETRY_EXHAUSTED
  SETTLEMENT_DELAY
  SELLER_CONFIRMATION_DELAY
  RECEIPT_FAILURE
  RECEIPT_PENDING
  REQUEST_PAUSED
}

enum OperatorCaseSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum OperatorCaseStatus {
  OPEN
  INVESTIGATING
  ACTION_REQUIRED
  RESOLVED
  CLOSED
}

enum OperatorActionType {
  PAUSE_REQUEST
  RELEASE_REQUEST
  REQUEUE_PAYMENT
  ANNOTATE_CASE
  RESOLVE_CASE
}

enum NotificationStatus {
  UNREAD
  READ
}

enum AuthProviderMode {
  LOCAL_SIGNED
  IDENTITY_BRIDGE
  EXTERNAL_OIDC
}

enum AppSessionSource {
  LOCAL_SIGNED
  IDENTITY_PROVIDER
  INTERNAL_SUPPORT
}

enum SupportAccessGrantStatus {
  PENDING_REVIEW
  ACTIVE
  RECERTIFICATION_REQUIRED
  REJECTED
  REVOKED
  EXPIRED
}

enum SupportAccessGrantReviewDecision {
  APPROVED
  REJECTED
}

enum SupportAccessGrantReviewType {
  INITIAL
  RECERTIFICATION
}

enum SupportAccessReviewCampaignStatus {
  OPEN
  COMPLETED
  CANCELED
}

enum SupportAccessReviewCampaignItemStatus {
  PENDING
  RECERTIFIED
  REVOKED
}

enum IdentityProviderLinkStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum ExternalIdentityAssignmentStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum OperationalIntegrationKind {
  UPSTREAM_IDENTITY
  RESTORE_DRILL
  SECRET_ROTATION
  DEPLOYMENT_AUTOMATION
}

enum OperationalIntegrationStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum OperationalIntegrationVerificationStatus {
  PENDING
  VERIFIED
  STALE
  FAILED
}

enum OperationalTargetEnvironment {
  DEVELOPMENT
  STAGING
  PRODUCTION
}

enum OperationalExecutionKind {
  RESTORE_DRILL
  SECRET_ROTATION
  DEPLOYMENT_PROMOTION
  UPSTREAM_IDENTITY
}

enum OperationalExecutionMode {
  DRY_RUN
  COMMAND
}

enum OperationalExecutionStatus {
  SUCCEEDED
  FAILED
}

enum OperationalProofArtifactKind {
  REPORT
  MANIFEST
  BACKUP
  BUNDLE
}

enum AuditActorType {
  HUMAN
  AGENT
  SYSTEM
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  name            String?
  memberships     Membership[]
  identityProviderLinks IdentityProviderLink[]
  externalIdentityAssignments ExternalIdentityAssignment[]
  managedIdentityProviderLinks IdentityProviderLink[] @relation("IdentityProviderLinkStatusChangedByUser")
  provisionedExternalIdentityAssignments ExternalIdentityAssignment[] @relation("ExternalIdentityAssignmentProvisionedByUser")
  managedExternalIdentityAssignments ExternalIdentityAssignment[] @relation("ExternalIdentityAssignmentStatusChangedByUser")
  authSessions    AuthSession[]
  approvals       Approval[]
  auditEvents     AuditEvent[]
  operatorActions OperatorAction[] @relation("OperatorActionUser")
  issuedSupportAccessGrants  SupportAccessGrant[] @relation("SupportAccessIssuedByUser")
  revokedSupportAccessGrants SupportAccessGrant[] @relation("SupportAccessRevokedByUser")
  supportAccessGrantReviews SupportAccessGrantReview[] @relation("SupportAccessReviewUser")
  supportAccessReviewCampaigns SupportAccessReviewCampaign[] @relation("SupportAccessReviewCampaignUser")
  createdOperationalIntegrations OperationalIntegration[] @relation("OperationalIntegrationCreatedByUser")
  updatedOperationalIntegrations OperationalIntegration[] @relation("OperationalIntegrationUpdatedByUser")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Organization {
  id             String         @id @default(cuid())
  kind           OrganizationKind
  slug           String         @unique
  name           String
  metadata       Json?
  memberships    Membership[]
  externalIdentityAssignments ExternalIdentityAssignment[]
  agents         Agent[]
  policies       Policy[]
  services       Service[]
  wallets        OrganizationWallet[]
  buyerRequests  SpendRequest[] @relation("BuyerOrganizationRequests")
  sellerRequests SpendRequest[] @relation("SellerOrganizationRequests")
  payments       Payment[]      @relation("BuyerOrganizationPayments")
  sellerPayments Payment[]      @relation("SellerOrganizationPayments")
  receipts       Receipt[]
  auditEvents    AuditEvent[]
  operatorCases  OperatorCase[]
  notifications  Notification[]
  authSessions   AuthSession[]
  issuedSupportAccessGrants SupportAccessGrant[] @relation("SupportAccessIssuedByOrganization")
  targetedSupportAccessGrants SupportAccessGrant[] @relation("SupportAccessTargetOrganization")
  supportAccessGrantReviews SupportAccessGrantReview[] @relation("SupportAccessReviewOrganization")
  supportAccessReviewCampaigns SupportAccessReviewCampaign[] @relation("SupportAccessReviewCampaignOrganization")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Membership {
  id             String         @id @default(cuid())
  userId         String
  organizationId String
  role           MembershipRole
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  externalIdentityAssignments ExternalIdentityAssignment[]
  authSessions   AuthSession[]
  createdAt      DateTime       @default(now())

  @@unique([userId, organizationId, role])
}

model IdentityProviderLink {
  id                 String                   @id @default(cuid())
  provider           String
  subject            String
  userId             String
  status             IdentityProviderLinkStatus @default(ACTIVE)
  statusReason       String?
  statusChangedAt    DateTime?
  statusChangedByUserId String?
  metadata           Json?
  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  statusChangedByUser User?                   @relation("IdentityProviderLinkStatusChangedByUser", fields: [statusChangedByUserId], references: [id], onDelete: SetNull)
  linkedAt           DateTime                 @default(now())
  lastAuthenticatedAt DateTime                @default(now())

  @@unique([provider, subject])
  @@index([userId, provider])
  @@index([status, lastAuthenticatedAt])
}

model ExternalIdentityAssignment {
  id                    String                           @id @default(cuid())
  provider              String
  externalEmail         String
  userId                String
  organizationId        String
  membershipId          String
  status                ExternalIdentityAssignmentStatus @default(ACTIVE)
  statusReason          String?
  metadata              Json?
  provisionedByUserId   String
  statusChangedByUserId String?
  provisionedAt         DateTime                         @default(now())
  statusChangedAt       DateTime?
  lastExchangedAt       DateTime?
  createdAt             DateTime                         @default(now())
  updatedAt             DateTime                         @updatedAt
  user                  User                             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization          Organization                     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership            Membership                       @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  provisionedByUser     User                             @relation("ExternalIdentityAssignmentProvisionedByUser", fields: [provisionedByUserId], references: [id], onDelete: Restrict)
  statusChangedByUser   User?                            @relation("ExternalIdentityAssignmentStatusChangedByUser", fields: [statusChangedByUserId], references: [id], onDelete: SetNull)

  @@unique([provider, externalEmail, membershipId])
  @@index([provider, externalEmail, status])
  @@index([organizationId, status])
  @@index([membershipId, status])
}

model AuthSession {
  id               String           @id @default(cuid())
  userId           String
  organizationId   String
  membershipId     String
  source           AppSessionSource
  authProviderMode AuthProviderMode
  provider         String?
  providerSubject  String?
  expiresAt        DateTime
  revokedAt        DateTime?
  lastSeenAt       DateTime         @default(now())
  metadata         Json?
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership       Membership       @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([userId, expiresAt])
  @@index([organizationId, expiresAt])
  @@index([membershipId, expiresAt])
  @@index([source, expiresAt])
}

model OperationalIntegration {
  id                 String                                  @id @default(cuid())
  kind               OperationalIntegrationKind
  targetEnvironment  OperationalTargetEnvironment
  provider           String
  label              String
  ownerEmail         String
  endpointReference  String?
  secretReference    String?
  configReference    String?
  status             OperationalIntegrationStatus            @default(ACTIVE)
  verificationStatus OperationalIntegrationVerificationStatus @default(PENDING)
  verificationReason String?
  statusReason       String?
  metadata           Json?
  lastVerifiedAt     DateTime?
  lastUsedAt         DateTime?
  createdByUserId    String
  updatedByUserId    String?
  createdByUser      User                                    @relation("OperationalIntegrationCreatedByUser", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedByUser      User?                                   @relation("OperationalIntegrationUpdatedByUser", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  executions         OperationalExecution[]
  createdAt          DateTime                                @default(now())
  updatedAt          DateTime                                @updatedAt

  @@unique([kind, targetEnvironment, provider, label])
  @@index([kind, targetEnvironment, status, verificationStatus])
  @@index([targetEnvironment, provider, status])
}

model OperationalExecution {
  id                     String                     @id @default(cuid())
  kind                   OperationalExecutionKind
  mode                   OperationalExecutionMode
  status                 OperationalExecutionStatus
  targetEnvironment      OperationalTargetEnvironment?
  provider               String
  actorUserEmail         String
  summary                String
  providerOperationId    String?
  targetReference        String?
  reportPath             String?
  metadata               Json?
  operationalIntegrationId String?
  operationalIntegration OperationalIntegration?   @relation(fields: [operationalIntegrationId], references: [id], onDelete: SetNull)
  proofArtifacts         OperationalProofArtifact[]
  completedAt            DateTime
  createdAt              DateTime                   @default(now())

  @@index([kind, completedAt])
  @@index([targetEnvironment, completedAt])
  @@index([provider, completedAt])
  @@index([operationalIntegrationId, completedAt])
}

model OperationalProofArtifact {
  id          String                    @id @default(cuid())
  executionId String
  kind        OperationalProofArtifactKind
  label       String
  filePath    String
  sha256      String
  sizeBytes   Int
  metadata    Json?
  execution   OperationalExecution      @relation(fields: [executionId], references: [id], onDelete: Cascade)
  createdAt   DateTime                  @default(now())

  @@index([executionId, kind])
}

model Agent {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  externalRef    String?
  status         AgentStatus  @default(DRAFT)
  policyId       String?
  metadata       Json?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  policy         Policy?      @relation(fields: [policyId], references: [id], onDelete: SetNull)
  requests       SpendRequest[]
  auditEvents    AuditEvent[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Policy {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  status         PolicyStatus @default(DRAFT)
  version        Int          @default(1)
  rules          Json
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agents         Agent[]
  requests       SpendRequest[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model SpendRequest {
  id                   String             @id @default(cuid())
  organizationId       String
  agentId              String
  policyId             String?
  sellerOrganizationId String?
  serviceKey           String?
  idempotencyKey       String?
  title                String
  purpose              String
  amountMinor          Int
  currency             String             @default("USD")
  serviceCategory      String
  status               SpendRequestStatus @default(DRAFT)
  evaluationResult     Json?
  requestPayload       Json
  metadata             Json?
  organization         Organization       @relation("BuyerOrganizationRequests", fields: [organizationId], references: [id], onDelete: Cascade)
  agent                Agent              @relation(fields: [agentId], references: [id], onDelete: Cascade)
  policy               Policy?            @relation(fields: [policyId], references: [id], onDelete: SetNull)
  sellerOrganization   Organization?      @relation("SellerOrganizationRequests", fields: [sellerOrganizationId], references: [id], onDelete: SetNull)
  approval             Approval?
  payment              Payment?
  receipt              Receipt?
  auditEvents          AuditEvent[]
  operatorCases        OperatorCase[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([organizationId, status])
  @@index([sellerOrganizationId, serviceKey])
  @@unique([organizationId, idempotencyKey])
}

model Service {
  id              String                @id @default(cuid())
  organizationId  String
  key             String
  name            String
  description     String
  category        String
  status          ServiceStatus         @default(DRAFT)
  visibility      ServiceVisibilityMode @default(PRIVATE)
  pricingModel    ServicePricingModel   @default(FIXED)
  priceMinor      Int
  currency        String                @default("USD")
  metadata        Json?
  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([organizationId, key])
  @@index([organizationId, status])
}

model Approval {
  id             String         @id @default(cuid())
  requestId      String         @unique
  approverId     String?
  status         ApprovalStatus @default(PENDING)
  decisionReason String?
  request        SpendRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  approver       User?          @relation(fields: [approverId], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Payment {
  id                   String        @id @default(cuid())
  requestId            String        @unique
  organizationId       String
  sellerOrganizationId String?
  rail                 PaymentRail   @default(INTERNAL_SIMULATED)
  provider             String
  reference            String?
  status               PaymentStatus @default(PENDING)
  amountMinor          Int
  currency             String        @default("USD")
  metadata             Json?
  request              SpendRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  organization         Organization  @relation("BuyerOrganizationPayments", fields: [organizationId], references: [id], onDelete: Cascade)
  sellerOrganization   Organization? @relation("SellerOrganizationPayments", fields: [sellerOrganizationId], references: [id], onDelete: SetNull)
  attempts             PaymentAttempt[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

model PaymentAttempt {
  id            String        @id @default(cuid())
  paymentId     String
  attemptNumber Int
  rail          PaymentRail
  status        PaymentStatus
  reference     String?
  evidence      Json?
  errorCode     String?
  errorMessage  String?
  payment       Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now())

  @@unique([paymentId, attemptNumber])
  @@index([rail, status])
}

model Receipt {
  id             String         @id @default(cuid())
  requestId      String         @unique
  organizationId String
  storageKey     String?
  contentType    String?
  status         ReceiptStatus @default(PENDING)
  metadata       Json?
  request        SpendRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model OrganizationWallet {
  id                 String                       @id @default(cuid())
  organizationId     String
  chain              ProgrammableSettlementChain
  address            String
  label              String
  ownershipLabel     String
  verificationStatus WalletVerificationStatus    @default(PENDING)
  verificationNote   String?
  isDefault          Boolean                     @default(false)
  metadata           Json?
  organization       Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  @@unique([organizationId, chain, address])
  @@index([organizationId, verificationStatus])
}

model SupportAccessGrant {
  id                   String                   @id @default(cuid())
  issuedByUserId       String
  issuedByOrganizationId String
  targetOrganizationId String
  targetWorkspace      OrganizationKind
  authProviderMode     AuthProviderMode
  reason               String
  status               SupportAccessGrantStatus @default(PENDING_REVIEW)
  expiresAt            DateTime
  lastReviewedAt       DateTime?
  reviewExpiresAt      DateTime?
  lastActivatedAt      DateTime?
  revokedAt            DateTime?
  revokedReason        String?
  revokedByUserId      String?
  metadata             Json?
  issuedByUser         User                     @relation("SupportAccessIssuedByUser", fields: [issuedByUserId], references: [id], onDelete: Cascade)
  issuedByOrganization Organization             @relation("SupportAccessIssuedByOrganization", fields: [issuedByOrganizationId], references: [id], onDelete: Cascade)
  targetOrganization   Organization             @relation("SupportAccessTargetOrganization", fields: [targetOrganizationId], references: [id], onDelete: Cascade)
  revokedByUser        User?                    @relation("SupportAccessRevokedByUser", fields: [revokedByUserId], references: [id], onDelete: SetNull)
  reviews              SupportAccessGrantReview[]
  reviewCampaignItems  SupportAccessReviewCampaignItem[]
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@index([issuedByOrganizationId, status, createdAt])
  @@index([targetOrganizationId, status, createdAt])
  @@index([status, reviewExpiresAt])
}

model SupportAccessGrantReview {
  id                     String                          @id @default(cuid())
  supportAccessGrantId   String
  reviewerUserId         String
  reviewerOrganizationId String
  reviewType             SupportAccessGrantReviewType
  decision               SupportAccessGrantReviewDecision
  reason                 String
  supportAccessGrant     SupportAccessGrant              @relation(fields: [supportAccessGrantId], references: [id], onDelete: Cascade)
  reviewerUser           User                            @relation("SupportAccessReviewUser", fields: [reviewerUserId], references: [id], onDelete: Cascade)
  reviewerOrganization   Organization                    @relation("SupportAccessReviewOrganization", fields: [reviewerOrganizationId], references: [id], onDelete: Cascade)
  createdAt              DateTime                        @default(now())

  @@index([supportAccessGrantId, createdAt])
  @@index([reviewerOrganizationId, createdAt])
  @@index([supportAccessGrantId, reviewType, createdAt])
}

model SupportAccessReviewCampaign {
  id              String                            @id @default(cuid())
  organizationId  String
  createdByUserId String
  title           String
  reason          String
  status          SupportAccessReviewCampaignStatus @default(OPEN)
  dueAt           DateTime
  completedAt     DateTime?
  metadata        Json?
  organization    Organization                      @relation("SupportAccessReviewCampaignOrganization", fields: [organizationId], references: [id], onDelete: Cascade)
  createdByUser   User                              @relation("SupportAccessReviewCampaignUser", fields: [createdByUserId], references: [id], onDelete: Cascade)
  items           SupportAccessReviewCampaignItem[]
  createdAt       DateTime                          @default(now())
  updatedAt       DateTime                          @updatedAt

  @@index([organizationId, status, dueAt])
}

model SupportAccessReviewCampaignItem {
  id                   String                                @id @default(cuid())
  campaignId           String
  supportAccessGrantId String
  status               SupportAccessReviewCampaignItemStatus @default(PENDING)
  resolutionReason     String?
  resolvedAt           DateTime?
  metadata             Json?
  campaign             SupportAccessReviewCampaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  supportAccessGrant   SupportAccessGrant                    @relation(fields: [supportAccessGrantId], references: [id], onDelete: Cascade)
  createdAt            DateTime                              @default(now())
  updatedAt            DateTime                              @updatedAt

  @@unique([campaignId, supportAccessGrantId])
  @@index([supportAccessGrantId, status])
}

model AuditEvent {
  id             String         @id @default(cuid())
  organizationId String?
  userId         String?
  agentId        String?
  requestId      String?
  actorType      AuditActorType
  eventType      String
  targetType     String
  targetId       String
  payload        Json
  occurredAt     DateTime       @default(now())
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  agent          Agent?         @relation(fields: [agentId], references: [id], onDelete: SetNull)
  request        SpendRequest?  @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId])
}

model OperatorCase {
  id               String               @id @default(cuid())
  caseKey          String               @unique
  organizationId   String?
  requestId        String?
  category         OperatorCaseCategory
  severity         OperatorCaseSeverity
  status           OperatorCaseStatus   @default(OPEN)
  title            String
  summary          String
  resolutionReason String?
  metadata         Json?
  organization     Organization?        @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  request          SpendRequest?        @relation(fields: [requestId], references: [id], onDelete: SetNull)
  actions          OperatorAction[]
  notifications    Notification[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([status, severity, category])
  @@index([organizationId, status])
}

model OperatorAction {
  id          String             @id @default(cuid())
  caseId       String
  actorUserId  String
  actionType   OperatorActionType
  reason       String
  metadata     Json?
  case         OperatorCase      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actorUser    User              @relation("OperatorActionUser", fields: [actorUserId], references: [id], onDelete: Cascade)
  createdAt    DateTime          @default(now())

  @@index([caseId, createdAt])
}

model Notification {
  id             String             @id @default(cuid())
  dedupeKey      String             @unique
  organizationId String?
  caseId         String?
  category       String
  title          String
  description    String
  status         NotificationStatus @default(UNREAD)
  metadata       Json?
  organization   Organization?      @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  case           OperatorCase?      @relation(fields: [caseId], references: [id], onDelete: SetNull)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([organizationId, status])
}
