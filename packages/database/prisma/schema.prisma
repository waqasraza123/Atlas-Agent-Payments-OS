generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationKind {
  BUYER
  SELLER
  OPERATOR
}

enum MembershipRole {
  OWNER
  ADMIN
  OPERATOR
  REVIEWER
  FINANCE
}

enum AgentStatus {
  DRAFT
  ACTIVE
  PAUSED
  DISABLED
}

enum PolicyStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ServiceStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ServiceVisibilityMode {
  PRIVATE
  TRUSTED_BUYERS
  PUBLIC
}

enum ServicePricingModel {
  FIXED
}

enum SpendRequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  EXECUTING
  COMPLETED
  FAILED
  CANCELED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  VOIDED
}

enum PaymentRail {
  INTERNAL_SIMULATED
  STRIPE
}

enum ReceiptStatus {
  PENDING
  AVAILABLE
  FAILED
}

enum OperatorCaseCategory {
  PAYMENT_FAILURE
  PAYMENT_RETRY_EXHAUSTED
  SETTLEMENT_DELAY
  SELLER_CONFIRMATION_DELAY
  RECEIPT_FAILURE
  RECEIPT_PENDING
  REQUEST_PAUSED
}

enum OperatorCaseSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum OperatorCaseStatus {
  OPEN
  INVESTIGATING
  ACTION_REQUIRED
  RESOLVED
  CLOSED
}

enum OperatorActionType {
  PAUSE_REQUEST
  RELEASE_REQUEST
  REQUEUE_PAYMENT
  ANNOTATE_CASE
  RESOLVE_CASE
}

enum NotificationStatus {
  UNREAD
  READ
}

enum AuditActorType {
  HUMAN
  AGENT
  SYSTEM
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  name            String?
  memberships     Membership[]
  approvals       Approval[]
  auditEvents     AuditEvent[]
  operatorActions OperatorAction[] @relation("OperatorActionUser")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Organization {
  id             String         @id @default(cuid())
  kind           OrganizationKind
  slug           String         @unique
  name           String
  memberships    Membership[]
  agents         Agent[]
  policies       Policy[]
  services       Service[]
  buyerRequests  SpendRequest[] @relation("BuyerOrganizationRequests")
  sellerRequests SpendRequest[] @relation("SellerOrganizationRequests")
  payments       Payment[]      @relation("BuyerOrganizationPayments")
  sellerPayments Payment[]      @relation("SellerOrganizationPayments")
  receipts       Receipt[]
  auditEvents    AuditEvent[]
  operatorCases  OperatorCase[]
  notifications  Notification[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Membership {
  id             String         @id @default(cuid())
  userId         String
  organizationId String
  role           MembershipRole
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())

  @@unique([userId, organizationId, role])
}

model Agent {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  externalRef    String?
  status         AgentStatus  @default(DRAFT)
  policyId       String?
  metadata       Json?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  policy         Policy?      @relation(fields: [policyId], references: [id], onDelete: SetNull)
  requests       SpendRequest[]
  auditEvents    AuditEvent[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Policy {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  status         PolicyStatus @default(DRAFT)
  version        Int          @default(1)
  rules          Json
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agents         Agent[]
  requests       SpendRequest[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model SpendRequest {
  id                   String             @id @default(cuid())
  organizationId       String
  agentId              String
  policyId             String?
  sellerOrganizationId String?
  serviceKey           String?
  idempotencyKey       String?
  title                String
  purpose              String
  amountMinor          Int
  currency             String             @default("USD")
  serviceCategory      String
  status               SpendRequestStatus @default(DRAFT)
  evaluationResult     Json?
  requestPayload       Json
  metadata             Json?
  organization         Organization       @relation("BuyerOrganizationRequests", fields: [organizationId], references: [id], onDelete: Cascade)
  agent                Agent              @relation(fields: [agentId], references: [id], onDelete: Cascade)
  policy               Policy?            @relation(fields: [policyId], references: [id], onDelete: SetNull)
  sellerOrganization   Organization?      @relation("SellerOrganizationRequests", fields: [sellerOrganizationId], references: [id], onDelete: SetNull)
  approval             Approval?
  payment              Payment?
  receipt              Receipt?
  auditEvents          AuditEvent[]
  operatorCases        OperatorCase[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([organizationId, status])
  @@index([sellerOrganizationId, serviceKey])
  @@unique([organizationId, idempotencyKey])
}

model Service {
  id              String                @id @default(cuid())
  organizationId  String
  key             String
  name            String
  description     String
  category        String
  status          ServiceStatus         @default(DRAFT)
  visibility      ServiceVisibilityMode @default(PRIVATE)
  pricingModel    ServicePricingModel   @default(FIXED)
  priceMinor      Int
  currency        String                @default("USD")
  metadata        Json?
  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([organizationId, key])
  @@index([organizationId, status])
}

model Approval {
  id             String         @id @default(cuid())
  requestId      String         @unique
  approverId     String?
  status         ApprovalStatus @default(PENDING)
  decisionReason String?
  request        SpendRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  approver       User?          @relation(fields: [approverId], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Payment {
  id                   String        @id @default(cuid())
  requestId            String        @unique
  organizationId       String
  sellerOrganizationId String?
  rail                 PaymentRail   @default(INTERNAL_SIMULATED)
  provider             String
  reference            String?
  status               PaymentStatus @default(PENDING)
  amountMinor          Int
  currency             String        @default("USD")
  metadata             Json?
  request              SpendRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  organization         Organization  @relation("BuyerOrganizationPayments", fields: [organizationId], references: [id], onDelete: Cascade)
  sellerOrganization   Organization? @relation("SellerOrganizationPayments", fields: [sellerOrganizationId], references: [id], onDelete: SetNull)
  attempts             PaymentAttempt[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

model PaymentAttempt {
  id            String        @id @default(cuid())
  paymentId     String
  attemptNumber Int
  rail          PaymentRail
  status        PaymentStatus
  reference     String?
  evidence      Json?
  errorCode     String?
  errorMessage  String?
  payment       Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now())

  @@unique([paymentId, attemptNumber])
  @@index([rail, status])
}

model Receipt {
  id             String         @id @default(cuid())
  requestId      String         @unique
  organizationId String
  storageKey     String?
  contentType    String?
  status         ReceiptStatus @default(PENDING)
  metadata       Json?
  request        SpendRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model AuditEvent {
  id             String         @id @default(cuid())
  organizationId String?
  userId         String?
  agentId        String?
  requestId      String?
  actorType      AuditActorType
  eventType      String
  targetType     String
  targetId       String
  payload        Json
  occurredAt     DateTime       @default(now())
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  agent          Agent?         @relation(fields: [agentId], references: [id], onDelete: SetNull)
  request        SpendRequest?  @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId])
}

model OperatorCase {
  id               String               @id @default(cuid())
  caseKey          String               @unique
  organizationId   String?
  requestId        String?
  category         OperatorCaseCategory
  severity         OperatorCaseSeverity
  status           OperatorCaseStatus   @default(OPEN)
  title            String
  summary          String
  resolutionReason String?
  metadata         Json?
  organization     Organization?        @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  request          SpendRequest?        @relation(fields: [requestId], references: [id], onDelete: SetNull)
  actions          OperatorAction[]
  notifications    Notification[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([status, severity, category])
  @@index([organizationId, status])
}

model OperatorAction {
  id          String             @id @default(cuid())
  caseId       String
  actorUserId  String
  actionType   OperatorActionType
  reason       String
  metadata     Json?
  case         OperatorCase      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actorUser    User              @relation("OperatorActionUser", fields: [actorUserId], references: [id], onDelete: Cascade)
  createdAt    DateTime          @default(now())

  @@index([caseId, createdAt])
}

model Notification {
  id             String             @id @default(cuid())
  dedupeKey      String             @unique
  organizationId String?
  caseId         String?
  category       String
  title          String
  description    String
  status         NotificationStatus @default(UNREAD)
  metadata       Json?
  organization   Organization?      @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  case           OperatorCase?      @relation(fields: [caseId], references: [id], onDelete: SetNull)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([organizationId, status])
}
