{
  "name": "@atlas/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- next dev --port 3000",
    "build": "dotenv -e ../../.env -- next build",
    "start": "dotenv -e ../../.env -- next start --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@atlas/auth": "workspace:*",
    "@atlas/config": "workspace:*",
    "@atlas/database": "workspace:*",
    "@atlas/domain": "workspace:*",
    "@atlas/types": "workspace:*",
    "@atlas/ui": "workspace:*",
    "next": "^16.2.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.2.2"
  }
}
